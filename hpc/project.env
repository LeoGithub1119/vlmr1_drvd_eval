# 專案環境設定（每個 repo 都會不一樣）

# 建議固定到 /work（shared，compute node 直接可用）
export WORK_DIR=/work/foobarbaz911/vlmr1

# uv venv 路徑（你現在已經在 open-r1-multimodal 建好 .venv）
export VENV_DIR=/home/foobarbaz911/VLM-R1/src/open-r1-multimodal/.venv

# modules（你的叢集有 miniconda3/cuda module）
export CUDA_MODULE=cuda/12.4
export MINICONDA_MODULE=miniconda3/24.11.1
